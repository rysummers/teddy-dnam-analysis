        <mxCell id="PrMfisUyi0FTpEPXQ27X-41" parent="1" style="rounded=1;html=1;fillColor=#fa6800;fontColor=#000000;strokeColor=#C73500;align=left;whiteSpace=wrap;verticalAlign=top;" value="&lt;font&gt;&lt;b style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;font style=&quot;color: rgb(255, 255, 255); font-size: 15px;&quot;&gt; &amp;nbsp;12 Predicted M-values at age(a):&lt;/font&gt;&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;&lt;font style=&quot;color: rgb(255, 255, 255); font-size: 15px;&quot;&gt;a = 2.4mo – 6mo – 9mo – 1.2yrs – 1.5yrs – 1.75yrs – 2yrs – 2.5yrs -3yrs - 3.7yrs – 6.2yrs&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;color: rgb(255, 255, 255); font-size: 15px;&quot;&gt;Trajectories affected by sub-trajectories. Makes identifying &quot;flat&quot; CpGs more difficult&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font color=&quot;#ffffff&quot;&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;Sensitivity analysis ran on sample of 25k CpGs to determine model fit metrics between ns(df=3,4,5). Based on AIC and BIC df=3 was overwhelmingly preffered&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;p class=&quot;MsoNormal&quot; style=&quot;font-size: 12pt; margin: 0in 0in 8pt; line-height: 18.4px; font-family: Aptos, sans-serif;&quot;&gt;&lt;/p&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="240" width="310" x="640" y="600" as="geometry" />
        </mxCell>
        <mxCell id="07h6ZqRHrtWbWdljW0Pn-2" parent="1" style="rounded=1;html=1;fillColor=#CCCCCC;fontColor=default;strokeColor=#001DBC;align=left;whiteSpace=wrap;verticalAlign=top;" value="&lt;font&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp;Excluded :&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;XXX CpGs with bi/tri-modal trajectories&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;XXX CpGs with &quot;flat&quot; trajectories&amp;nbsp;&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
